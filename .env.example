# Base de développement (Neon ou PostgreSQL local)
DATABASE_URL=postgres://user:password@host/chhal_dev
# Base de test : le nom DOIT finir par _test
DATABASE_URL_TEST=postgres://user:password@host/chhal_test
# Jeton unique pour /admin (phase 4)
ADMIN_TOKEN=change-me
PORT=3001
CORS_ORIGIN=http://localhost:3000
ALLOW_TEST_DATA=1
# Web : par défaut le navigateur appelle /api-proxy (même origine, relayé vers l'API). Ne définir NEXT_PUBLIC_API_URL que pour une API sur un autre domaine.
# API_INTERNAL_URL=http://localhost:3001
# Contact publié dans le User-Agent des robots (courriel ou URL de votre choix). Vide = « non configuré ».
SCRAPER_CONTACT=
