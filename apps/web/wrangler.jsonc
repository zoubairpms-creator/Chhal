{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chhal-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "chhal-web"
    }
  ],
  "vars": {
    "CHHAL_CLOUDFLARE": "1"
  },
  "workers_dev": true
}
